# Django
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database
POSTGRES_DB=oceanacross
POSTGRES_USER=oceanuser
POSTGRES_PASSWORD=oceanpass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# GitHub OAuth
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: http://localhost
# Callback URL: http://localhost/api/auth/social/github/callback/
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_GITHUB_OAUTH_URL=http://localhost/api/auth/social/github/
